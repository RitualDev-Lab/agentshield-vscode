{
  "name": "agentshield-defense",
  "displayName": "AgentShield — AI Agent Security & Sandbox",
  "description": "Zero-leak secret defense, kernel sandboxing, real-time status bar guardrails, and DBShield mutation approvals for Claude Code, Cursor, Windsurf, and Copilot.",
  "version": "0.2.1",
  "publisher": "ritualdev-lab",
  "author": {
    "name": "RitualDev Studio",
    "email": "developer@ritualdev.in",
    "url": "https://ritualdev.in"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RitualDev-Lab/agentshield-vscode.git"
  },
  "homepage": "https://ritualdev.in/agentshield",
  "bugs": {
    "url": "https://github.com/RitualDev-Lab/agentshield-vscode/issues"
  },
  "license": "MIT",
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "agentshield",
    "ai-security",
    "cursor",
    "windsurf",
    "sandbox",
    "secret-detection",
    "claude-code",
    "zero-leak"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentshield-sidebar",
          "title": "AgentShield",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "agentshield-sidebar": [
        {
          "id": "agentshield.mutationsView",
          "name": "DBShield Mutation Approvals"
        },
        {
          "id": "agentshield.sandboxView",
          "name": "OS Sandbox Runtime Profile"
        }
      ]
    },
    "commands": [
      {
        "command": "agentshield.scanActiveFile",
        "title": "AgentShield: Scan Active File for Secret Leaks",
        "category": "AgentShield"
      },
      {
        "command": "agentshield.auditWorkspace",
        "title": "AgentShield: Audit Entire Workspace",
        "category": "AgentShield"
      },
      {
        "command": "agentshield.openPlayground",
        "title": "AgentShield: Open Adversarial Attack Playground",
        "category": "AgentShield"
      },
      {
        "command": "agentshield.openTrustCenter",
        "title": "AgentShield: View SOC 2 / SIG Lite Trust Center",
        "category": "AgentShield"
      },
      {
        "command": "agentshield.approveMutation",
        "title": "Approve DB Mutation",
        "icon": "$(check)",
        "category": "AgentShield"
      },
      {
        "command": "agentshield.rejectMutation",
        "title": "Reject & Abort DB Mutation",
        "icon": "$(close)",
        "category": "AgentShield"
      },
      {
        "command": "agentshield.refreshMutations",
        "title": "Refresh Mutation Approvals",
        "icon": "$(refresh)",
        "category": "AgentShield"
      },
      {
        "command": "agentshield.simulateMutation",
        "title": "Simulate Inbound DB Mutation",
        "category": "AgentShield"
      },
      {
        "command": "agentshield.switchSandboxProfile",
        "title": "Switch Active OS Sandbox Profile",
        "category": "AgentShield"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "agentshield.approveMutation",
          "when": "view == agentshield.mutationsView && viewItem == mutationPending",
          "group": "inline@1"
        },
        {
          "command": "agentshield.rejectMutation",
          "when": "view == agentshield.mutationsView && viewItem == mutationPending",
          "group": "inline@2"
        }
      ],
      "view/title": [
        {
          "command": "agentshield.refreshMutations",
          "when": "view == agentshield.mutationsView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "AgentShield",
      "properties": {
        "agentshield.enableStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show live defense status in the IDE status bar."
        },
        "agentshield.airGappedMode": {
          "type": "boolean",
          "default": true,
          "description": "Enforce 100% offline air-gapped isolation with zero outbound telemetry."
        },
        "agentshield.strictLeakBlocking": {
          "type": "boolean",
          "default": true,
          "description": "Block file saves and agent commits if unredacted API keys are detected."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "test": "node dist/extension.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
